NODE_ENV=development
# Use "local" on your laptop. OpenShift environments use dev, test, or prod (set in GitOps).
DEPLOY_ENV=local

# Database (matches docker-compose.yml: user postgres, password default)
POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=default
POSTGRES_PORT=5432
POSTGRES_DATABASE=postgres
POSTGRES_SCHEMA=csa
# Leave empty to build the URL from POSTGRES_* vars above.
DATABASE_URL=

FILE_TRANSFER_SERVICE_URL=http://localhost:4000
# Repo root .local/storage (path relative to backend/ when running npm run start:dev)
FILE_STORAGE_PATH=../.local/storage
CRA_ENVIRONMENT=test
CRA_USER_ID=TST0016
CRA_BUSINESS_NUM=TESTBN000000001
CRA_LAST_SEQUENCE_NUMBER=0
CRA_INTEGRATION_ENABLED=false
ENABLE_SWAGGER=true

# ICM API / Auth
ICM_API_URL=http://localhost:8080
ICM_TRUSTED_USERNAME=admin
ICM_API_USERNAME=
ICM_TOKEN_URL=http://localhost:8180/realms/icm/protocol/openid-connect/token
ICM_CLIENT_ID=csa-backend
ICM_CLIENT_SECRET=client-secret
ICM_WORKSPACE=

# SSO Keycloak (required in deployed environments; optional when DEPLOY_ENV=local)
# SSO_KEYCLOAK_URL=
# SSO_KEYCLOAK_REALM=

# Sync / Ingestion
ICM_CURSOR_LOOKBACK_DAYS=2
# With DEPLOY_ENV=local, ICM/MIS fixtures are read from FILE_STORAGE_PATH (see make fixtures).
# S3 settings below are only required in deployed environments (dev/test/prod).
# s3URI=
# s3BucketName=
MIS_S3_PREFIX=csas3/
