NODE_ENV=development

POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=postgres
POSTGRES_SCHEMA=csa
DATABASE_URL=

FILE_TRANSFER_SERVICE_URL=http://localhost:4000
FILE_STORAGE_PATH=./temp/

# Sync / Ingestion
ICM_CURSOR_LOOKBACK_DAYS=2
USE_MOCK_DATA=true

# S3/MinIO (shared across services — not required when USE_MOCK_DATA=true)
# Credentials are embedded in the URI: http://accessKey:secretKey@host:port
s3URI=http://minioadmin:minioadmin@localhost:9000
s3BucketName=csa-data
MIS_S3_PREFIX=csas3/
MIS_STALENESS_THRESHOLD_HOURS=48
