{
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "builder": "swc",
    "typeCheck": true,
    "watchAssets": true,
    "assets": [
      {
        "include": "api/mock/data/**/*.json",
        "watchAssets": true
      }
    ]
  },
  "projects": {
    "api": {
      "type": "application",
      "root": "src",
      "entryFile": "api/main",
      "sourceRoot": "src",
      "compilerOptions": {
        "tsConfigPath": "tsconfig.build.json"
      }
    },
    "data-ingestion": {
      "type": "application",
      "root": "src",
      "entryFile": "jobs/entrypoints/data-ingestion",
      "sourceRoot": "src",
      "compilerOptions": {
        "tsConfigPath": "tsconfig.build.json"
      }
    },
    "cra-file-transfer": {
      "type": "application",
      "root": "src",
      "entryFile": "jobs/entrypoints/cra-file-transfer",
      "sourceRoot": "src",
      "compilerOptions": {
        "tsConfigPath": "tsconfig.build.json"
      }
    },
    "cra-response-poll": {
      "type": "application",
      "root": "src",
      "entryFile": "jobs/entrypoints/cra-response-poll",
      "sourceRoot": "src",
      "compilerOptions": {
        "tsConfigPath": "tsconfig.build.json"
      }
    },
    "retry-failed": {
      "type": "application",
      "root": "src",
      "entryFile": "jobs/entrypoints/retry-failed",
      "sourceRoot": "src",
      "compilerOptions": {
        "tsConfigPath": "tsconfig.build.json"
      }
    }
  }
}
