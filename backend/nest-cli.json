{
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "entryFile": "api/main",
  "compilerOptions": {
    "builder": "swc",
    "typeCheck": true,
    "watchAssets": true,
    "assets": [
      {
        "include": "src/api/mock/data/**/*",
        "outDir": "dist/api/mock/data",
        "watchAssets": true
      }
    ]
  }
}
