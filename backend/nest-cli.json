{
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "entryFile": "api/main",
  "compilerOptions": {
    "builder": "swc",
    "typeCheck": true,
    "watchAssets": true,
    "assets": [
      {
        "include": "api/mock/data/**/*.json",
        "watchAssets": true
      },
      {
        "include": "sync/mock-data/**/*.json",
        "watchAssets": true
      },
      {
        "include": "sync/mock-data/**/*.csv",
        "watchAssets": true
      }
    ]
  }
}
