generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  moduleFormat  = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["csa"]
}

model Contact {
  id                         Int       @id @default(autoincrement())

  // Required (NOT NULL)
  lastName                   String    @map("last_name")
  firstName                  String    @map("first_name")
  middleName                 String    @map("middle_name")
  akaLastName                String    @map("aka_last_name")
  akaFirstName               String    @map("aka_first_name")
  personIdIcm                String    @map("person_id_icm")
  contactIdIcm               String?   @map("contact_id_icm")
  personIdMis                String    @map("person_id_mis")
  caseNumber                 String    @map("case_number")
  caseType                   String    @map("case_type")
  caseStatus                 String    @map("case_status")
  caseLoad                   String    @map("case_load")
  sourceOrder                String    @map("source_order")
  icmIntegrationStatus       Boolean   @map("icm_integration_status")
  createdAt                  DateTime  @map("created_at") @db.Timestamptz()
  createdBy                  String    @map("created_by")
  lastUpdatedAt              DateTime  @map("last_updated_at") @db.Timestamptz()
  lastUpdatedBy              String    @map("last_updated_by")
  searchText                 String    @default(dbgenerated()) @map("search_text")

  // Optional (nullable in SQL)
  gender                     String?   @map("gender")
  dateOfBirth                DateTime? @db.Date @map("date_of_birth")
  age                        Int?      @map("age")
  legacyFileNumber           String?   @map("legacy_file_number")
  serviceOffice              String?   @map("service_office")
  assignedTo                 String?   @map("assigned_to")
  csaStatus                  String?   @map("csa_status")
  csaStatusEffectiveDate     DateTime? @map("csa_status_effective_date") @db.Timestamptz()
  csaSentDate                DateTime? @map("csa_sent_date") @db.Timestamptz()
  din                        String?   @map("din")
  effectiveLegalStatus       String?   @map("effective_legal_status")
  effectiveDate              DateTime? @map("effective_date") @db.Date
  expiryDate                 DateTime? @db.Date @map("expiry_date")
  enrollForCsa               String?   @map("enroll_for_csa")
  misLegalAuthorityCode      String?   @map("mis_legal_authority_code")
  legalAuthorityCode         String?   @map("legal_authority_code")
  birthCity                  String?   @map("birth_city")
  birthProvince              String?   @map("birth_province")
  birthCountry               String?   @map("birth_country")
  placementLocation          String?   @map("placement_location")
  locationType               String?   @map("location_type")
  locationSubType            String?   @map("location_sub_type")
  placementStatus            String?   @map("placement_status")
  actualStartDate            DateTime? @map("actual_start_date") @db.Date
  actualEndDate              DateTime? @map("actual_end_date") @db.Date
  paidUnpaid                 String?   @map("paid_unpaid")
  interruptedPlacement       String?   @map("interrupted_placement")
  sourcePlacement            String?   @map("source_placement")
  serviceProviderName        String?   @map("service_provider_name")
  providerId                 String?   @map("provider_id")
  placeOfServiceName         String?   @map("place_of_service_name")
  agreementType              String?   @map("agreement_type")
  agreementStatus            String?   @map("agreement_status")
  agreementStartDate         DateTime? @map("agreement_start_date") @db.Date
  agreementEndDate           DateTime? @map("agreement_end_date") @db.Date
  terminationDate            DateTime? @map("termination_date") @db.Date
  mcfdContract               String?   @map("mcfd_contract")
  orderNumber                String?   @map("order_number")
  orderType                  String?   @map("order_type")
  orderStatus                String?   @map("order_status")
  orderAmount                String?   @map("order_amount")
  orderEffectiveStartDate    DateTime? @db.Date @map("order_effective_start_date")
  orderEffectiveEndDate      DateTime? @db.Date @map("order_effective_end_date")
  product                    String?   @map("product")
  holdBy                     String?   @map("hold_by")
  holdReason                 String?   @map("hold_reason")
  resumeStatus               String?   @map("resume_status")
  preBatchStatus               String?   @map("pre_batch_status")
  prevRecipientFirstName     String?   @map("prev_recipient_first_name")
  prevRecipientLastName      String?   @map("prev_recipient_last_name")
  cancelReasonCode           String?   @map("cancel_reason_code")
  careEndDate                DateTime? @db.Date @map("care_end_date")
  needsReview                Boolean   @default(false) @map("needs_review")

  // Relations
  contactBatchDetails        ContactBatchDetail[]
  auditTrailEntries          ContactAuditTrail[]
  wklFileRecords             WklFileRecord[]

  @@map("contacts")
  @@schema("csa")
}

model ContactAuditTrail {
  id          Int      @id @default(autoincrement())
  contactId   Int      @map("contact_id")
  actionedAt  DateTime @default(now()) @map("actioned_at") @db.Timestamptz()
  actionedBy  String   @map("actioned_by")
  operation   String
  field       String?
  oldValue    String?  @map("old_value")
  newValue    String?  @map("new_value")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, actionedAt(sort: Desc)])
  @@map("contact_audit_trail")
  @@schema("csa")
}

model Batch {
  id                  Int                  @id @default(autoincrement())
  batchNumber         Int                  @unique @map("batch_number")
  batchDate           DateTime?            @map("batch_date") @db.Date
  status              String
  recordCount         Int                  @map("record_count")
  createdAt           DateTime             @map("created_at") @db.Timestamptz()
  updatedAt           DateTime             @map("updated_at") @db.Timestamptz() @updatedAt
  systemComments      String?              @map("system_comments")
  initiatedBy         String               @map("initiated_by")
  contactBatchDetails ContactBatchDetail[]
  transferFiles       TransferFile[]

  @@map("batches")
  @@schema("csa")
}

model ContactBatchDetail {
  id                Int       @id @default(autoincrement())
  contactId         Int       @map("contact_id")
  batchId           Int       @map("batch_id")
  transactionType   String    @map("transaction_type")
  referenceNumber   String?   @unique @map("reference_number")
  systemComments    String?   @map("system_comments")
  createdAt         DateTime  @map("created_at") @db.Timestamptz()
  createdBy         String    @map("created_by")
  lastUpdatedAt     DateTime  @map("last_updated_at") @db.Timestamptz() @updatedAt
  lastUpdatedBy     String    @map("last_updated_by")
  status            String?
  craMatchingSnapshot Json?   @map("cra_matching_snapshot") @db.JsonB
  // Snapshot of the transaction date at batch time. Despite the name, this holds
  // the application start date for applications and the care END date for cancellations
  // (see outbound-data.service.ts: feeds appStartDate or cancelEndDate accordingly).
  effectiveDate     DateTime? @db.Date @map("effective_date")
  cancelReasonCode  String?   @map("cancel_reason_code")
  batch             Batch     @relation(fields: [batchId], references: [id])
  contact           Contact   @relation(fields: [contactId], references: [id])
  wklFileRecords    WklFileRecord[]

  @@unique([contactId, batchId], name: "contact_batch_unique")
  @@map("contact_batch_details")
  @@schema("csa")
}

model TransferFile {
  id               Int       @id @default(autoincrement())
  batchId          Int?      @map("batch_id")
  destinationId    String    @map("destination_id")
  direction        String
  fileType         String?   @map("file_type")
  fileName         String    @map("file_name")
  deliveredAt      DateTime? @map("delivered_at") @db.Timestamptz()
  downloadedAt     DateTime? @map("downloaded_at") @db.Timestamptz()
  referenceNumbers String[]  @map("reference_numbers")
  fileSize         String?   @map("file_size")
  isDetailsProcessed Boolean  @default(false) @map("is_processed")
  isValid          Boolean   @default(true) @map("is_valid")
  sequenceNumber   Int?      @map("sequence_number")
  batch            Batch?    @relation(fields: [batchId], references: [id])
  wklFileRecords   WklFileRecord[]

  @@map("transfer_files")
  @@schema("csa")
}

model WklFileRecord {
  id             Int       @id @default(autoincrement())
  transferFileId Int       @map("transfer_file_id")
  recordIndex    Int       @map("record_index")
  weeklyFileDate DateTime? @map("weekly_file_date") @db.Date
  recordData     Json      @map("record_data") @db.JsonB
  matchStatus    String    @map("match_status")
  contactId      Int?      @map("contact_id")
  batchDetailId  Int?      @map("batch_detail_id")
  matchedBy      String?   @map("matched_by")
  processedAt    DateTime? @map("processed_at") @db.Timestamptz()
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  transferFile TransferFile        @relation(fields: [transferFileId], references: [id])
  contact      Contact?            @relation(fields: [contactId], references: [id])
  batchDetail  ContactBatchDetail? @relation(fields: [batchDetailId], references: [id])

  @@unique([transferFileId, recordIndex], name: "wkl_file_record_unique")
  @@index([transferFileId])
  @@index([matchStatus])
  @@index([contactId])
  @@map("wkl_file_records")
  @@schema("csa")
}

model JobRun {
  id          Int       @id @default(autoincrement())
  jobType     String    @map("job_type")
  status      String
  parentJobId Int?      @map("parent_job_id")
  jobTrigger  String    @map("job_trigger")
  retryCount  Int       @default(0) @map("retry_count")
  error       String?
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  startedAt   DateTime  @map("started_at") @db.Timestamptz()
  completedAt DateTime? @map("completed_at") @db.Timestamptz()
  parentJob   JobRun?   @relation("ChildJobs", fields: [parentJobId], references: [id])
  childJobs   JobRun[]  @relation("ChildJobs")

  @@index([status])
  @@index([parentJobId])
  @@index([jobType, status])
  @@map("job_runs")
  @@schema("csa")
}
