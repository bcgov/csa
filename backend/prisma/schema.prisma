generator client {
  provider     = "prisma-client-js"
  moduleFormat = "cjs"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

// NOTE: The datasource URL is now configured in prisma.config.ts (Prisma 7+).
// This file no longer contains the `url` field for the datasource.
datasource db {
  provider = "postgresql"
  schemas  = ["csa"]
}

model applicants {
  id         Int     @id @default(autoincrement()) @map("id")
  last_name  String  @db.VarChar(100)
  given_name String  @db.VarChar(100)
  csa_status String  @db.VarChar(50)

  @@schema("csa")
}
