# Frontend Environment Variables
# Copy this file to .env and fill in the values
#
# Local setup with Colima (from repo root):
#   colima start
#   docker compose up -d database migrations
#   cd backend && npm run start:dev    # http://localhost:3000
#   cd frontend && npm run dev         # http://localhost:5173

# =============================================================================
# Development Server
# =============================================================================

# Port for Vite dev server (required by vite.config.ts)
PORT=5173

# Backend API URL for dev proxy (required by vite.config.ts)
# Host dev: backend listens on 3000
# Docker app profile: backend is exposed on http://localhost:3001
BACKEND_URL=http://localhost:3000

# =============================================================================
# Environment Indicator + local auth bypass
# =============================================================================

# Toolbar label/colour and runtime mode.
# Values: LOCAL (laptop dev, skips Keycloak), DEV, TEST, PRE-PROD, PROD
# LOCAL requires backend DEPLOY_ENV=local.
# In OpenShift, this comes from /config.json instead of .env.
VITE_APP_ENV=LOCAL

# =============================================================================
# Keycloak / SSO Configuration
# Only needed when VITE_APP_ENV is not LOCAL.
# In production, values are loaded from /config.json (runtime ConfigMap).
# =============================================================================

VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_REALM=
VITE_KEYCLOAK_CLIENT_ID=

# =============================================================================
# API Configuration
# =============================================================================

# Backend API base URL (optional, defaults to /api)
VITE_API_BASE_URL=

# Redirect URI after SSO login (optional)
VITE_APP_REDIRECT=
