# Frontend Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# Development Server
# =============================================================================

# Port for Vite dev server
PORT=5173

# Backend API URL for dev proxy (used by vite.config.ts)
BACKEND_URL=http://localhost:3001

# =============================================================================
# Keycloak / SSO Configuration
# These are used at build time for local development.
# In production, values are loaded from /config.json (runtime ConfigMap).
# =============================================================================

# Keycloak server URL

VITE_KEYCLOAK_URL=

# Keycloak realm
VITE_KEYCLOAK_REALM=

# Keycloak client ID (registered in SSO dashboard)
VITE_KEYCLOAK_CLIENT_ID=

# =============================================================================
# API Configuration
# =============================================================================

# Backend API base URL (optional, defaults to /api)
# In dev, the Vite proxy handles /api -> BACKEND_URL
# In prod, Caddy reverse proxies /api to the backend service
VITE_API_BASE_URL=

# =============================================================================
# Optional: SSO Redirect
# =============================================================================

# Redirect URI after SSO login (optional, defaults to window.location.origin)
VITE_APP_REDIRECT=

# =============================================================================
# Environment Indicator
# =============================================================================

# Application environment - controls toolbar background color and auth mode
# Values: LOCAL (bypass SSO), DEV (pink), TEST (yellow), PRE-PROD (grey), PROD (white/no color)
# When set to LOCAL:
#   - SSO/Keycloak authentication is completely bypassed
#   - A mock user and token are generated automatically
#   - Backend must also have SKIP_SSO_VERIFICATION=true
VITE_APP_ENV=LOCAL
