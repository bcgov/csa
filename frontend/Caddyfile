{
	metrics
	auto_https off
	admin 0.0.0.0:3003
	order coraza_waf first
}

:3000 {
	log {
		output stdout
		format console
		level info
	}

	# -------------------------------
	# Coraza WAF
	# -------------------------------
	coraza_waf {
		directives `
		Include /etc/caddy/coraza.conf
		`
	}

	# -------------------------------
	# Runtime config (ConfigMap)
	# EXACT match to prevent SPA rewrite
	# -------------------------------

  @config path /config.json
  handle @config {
	  root * /runtime-config
	  file_server
  }

	# -------------------------------
	# Backend API
	# -------------------------------
  @backend {
    path api/* /health
  }
	handle @backend {
		reverse_proxy VITE_API_BASE_URL {
			header_up Host {http.reverse_proxy.upstream.hostport}
			header_up X-Real-IP {remote_host}
		}
	}

	# -------------------------------
	# Static SPA assets
	# -------------------------------
	root * /srv
	encode zstd gzip

	# SPA fallback: only rewrite if
	# - not API
	# - not config.json
	# - not a real file
	@spa {
		not path /api* /config.json /health
		not file
	}
	rewrite @spa /index.html

	file_server

	# -------------------------------
	# Security headers
	# -------------------------------
	header {
		-Server
		X-Frame-Options "SAMEORIGIN"
		X-XSS-Protection "1;mode=block"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Permissions-Policy "fullscreen=(self), camera=(), microphone=()"
		Cross-Origin-Resource-Policy "cross-origin"
		Cross-Origin-Opener-Policy "unsafe-none"
		Strict-Transport-Security "max-age=31536000"
		Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate"

		# CSP — allows Keycloak iframe + redirects
		Content-Security-Policy "
			default-src 'self' https://*.gov.bc.ca;
			script-src 'self' https://*.gov.bc.ca 'unsafe-inline';
			style-src 'self' https://fonts.googleapis.com https://use.fontawesome.com 'unsafe-inline';
			font-src 'self' https://fonts.gstatic.com;
			img-src 'self' data: https://fonts.googleapis.com https://www.w3.org https://*.gov.bc.ca https://*.tile.openstreetmap.org;
			frame-src 'self' https://loginproxy.gov.bc.ca https://dev.loginproxy.gov.bc.ca https://*.gov.bc.ca;
			frame-ancestors 'self';
			form-action 'self';
			connect-src 'self' https://*.gov.bc.ca wss://*.gov.bc.ca;
			block-all-mixed-content;
		"
	}
}

:3001 {
	handle /health {
		respond "OK"
	}
}
